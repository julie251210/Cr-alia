<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Crealia</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: pink;
        }

        header {
            text-align: center;
            padding: 30px;
        }

        h1 {
            font-size: 50px;
        }

        h2 {
            font-weight: normal;
        }

        .menu {
            position: fixed;
            left: 0;
            top: 0;
            width: 200px;
            height: 100%;
            background-color: #fff;
            padding-top: 20px;
        }

        .menu select {
            width: 90%;
            margin: 10px;
            padding: 10px;
        }
    </style>
</head>
<body>

<div class="menu">
    <select onchange="changerPage(this.value)">
        <option value="">Choisir un style</option>
        <option value="rose.html">rose</option>
        <option value="bleu.html">bleu</option>
        <option value="bordeaux.html">rouge bordeaux</option>
    </select>
</div>

<header>
    <h1>Crealia</h1>
    <h2>là où naissent vos idées</h2>
</header>

<script>
function changerPage(page) {
    if(page !== "") {
        window.location.href = page;
    }
}
</script>

</body>
</html>


